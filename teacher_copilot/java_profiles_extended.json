  "AP-FRQ906422c04f2fa6d6S7": {
    "class_name": "AppleCrate",
    "fields": "Apple[][] apples;",
    "cases": [
      {
        "label": "排除腐烂及上下左右相邻苹果，保留对角线",
        "setup": "AppleCrate x=new AppleCrate();x.apples=new Apple[][]{{new Apple(10,true),new Apple(2,false)},{new Apple(3,false),new Apple(5,false)}};",
        "condition": "x.numberOfPies(2)==2"
      },
      {
        "label": "没有腐烂苹果，累计小数重量",
        "setup": "AppleCrate x=new AppleCrate();x.apples=new Apple[][]{{new Apple(.5,false),new Apple(.5,false),new Apple(.5,false)},{new Apple(.5,false),new Apple(.5,false),new Apple(.5,false)}};",
        "condition": "x.numberOfPies(1)==3"
      },
      {
        "label": "全部腐烂返回零",
        "setup": "AppleCrate x=new AppleCrate();x.apples=new Apple[][]{{new Apple(1,true),new Apple(1,true)},{new Apple(1,true),new Apple(1,true)}};",
        "condition": "x.numberOfPies(1)==0"
      }
    ],
    "kind": "methods",
    "support": "record Apple(double weight,boolean rotten){public double getWeight(){return weight;}public boolean isRotten(){return rotten;}}"
  },
  "AP-FRQ906422c04f2fa6d6S8": {
    "class_name": "Schedule",
    "fields": "Appointment[][] sched;",
    "cases": [
      {
        "label": "按列计数并比较内容而非字符串地址",
        "setup": "Schedule x=new Schedule();x.sched=new Appointment[][]{{new Appointment(new String(\"busy\"),1),new Appointment(\"free\",2),new Appointment(\"busy\",3)},{new Appointment(\"busy\",4),new Appointment(\"free\",5),new Appointment(\"free\",6)}};",
        "condition": "x.columnWithFewest(new String(\"busy\"))==1"
      },
      {
        "label": "并列最少接受任一列",
        "setup": "Schedule x=new Schedule();x.sched=new Appointment[][]{{new Appointment(\"free\",1),new Appointment(\"busy\",2),new Appointment(\"free\",3)}};int n=x.columnWithFewest(\"busy\");",
        "condition": "n==0||n==2"
      },
      {
        "label": "单列，无匹配值",
        "setup": "Schedule x=new Schedule();x.sched=new Appointment[][]{{new Appointment(\"busy\",1)},{new Appointment(\"free\",2)}};",
        "condition": "x.columnWithFewest(\"hold\")==0"
      }
    ],
    "kind": "methods",
    "support": "record Appointment(String status,int room){public String getStatus(){return status;}public int getRoomNumber(){return room;}}"
  },
  "AP-FRQ69fc5af861bea528S1": {
    "class_name": "SimulateCarRace",
    "fields": "RaceCar carOne,carTwo;",
    "cases": [
      {
        "label": "逐圈相加，从第 1 圈到末圈",
        "setup": "SimulateCarRace x=new SimulateCarRace();x.carOne=new RaceCar(1,10);x.carTwo=new RaceCar(4,4);",
        "condition": "x.findWinner(2).equals(\"Car 2 wins!\")"
      },
      {
        "label": "一圈获胜与平局",
        "setup": "SimulateCarRace x=new SimulateCarRace();x.carOne=new RaceCar(1);x.carTwo=new RaceCar(2);String a=x.findWinner(1);x.carTwo=new RaceCar(1);",
        "condition": "a.equals(\"Car 1 wins!\")&&x.findWinner(1).equals(\"Tie!\")"
      },
      {
        "label": "删除首尾及多次出现的指定子串",
        "setup": "SimulateCarRace x=new SimulateCarRace();",
        "condition": "x.shortenMessage(\"the_driver_of_the_first_car_is_Jerry\",\"the_\").equals(\"driver_of_first_car_is_Jerry\")&&x.shortenMessage(\"xyAxy\",\"xy\").equals(\"A\")&&x.shortenMessage(\"ok\",\"z\").equals(\"ok\")&&x.shortenMessage(\"xyxy\",\"xy\").equals(\"\")"
      }
    ],
    "kind": "methods",
    "support": "static class RaceCar{double[] times;RaceCar(double...t){times=t;}public double getLapTime(int n){return times[n-1];}}"
  },
  "AP-FRQ69fc5af861bea528S2": {
    "class_name": "MessageBuilder",
    "fields": "String message;int numWords;int nextIndex;public String getNextWord(String s){if(nextIndex>0&&!s.equals(messageWords[nextIndex-1]))throw new IllegalArgumentException(\"Use the previously returned word\");return nextIndex<messageWords.length?messageWords[nextIndex++]:null;}",
    "cases": [
      {
        "label": "构造消息时更新词数、空格和终止条件",
        "setup": "MessageBuilder x=new MessageBuilder(\"the\");",
        "condition": "x.message.equals(\"the book on the table\")&&x.numWords==5"
      },
      {
        "label": "缩写含首尾单词，不改变消息",
        "setup": "MessageBuilder x=new MessageBuilder(\"the\");x.message=\"as soon as possible\";",
        "condition": "x.getAbbreviation().equals(\"asap\")&&x.message.equals(\"as soon as possible\")"
      },
      {
        "label": "两个单字符单词",
        "setup": "MessageBuilder x=new MessageBuilder(\"the\");x.message=\"A B\";",
        "condition": "x.getAbbreviation().equals(\"AB\")"
      },
      {
        "label": "起始词已是最后一个词",
        "setup": "messageWords=new String[]{};MessageBuilder x=new MessageBuilder(\"alone\");",
        "condition": "x.message.equals(\"alone\")&&x.numWords==1"
      }
    ],
    "kind": "methods",
    "support": "static String[] messageWords={\"book\",\"on\",\"the\",\"table\"};"
  },
  "AP-FRQ69fc5af861bea528S5": {
    "class_name": "RobotMover",
    "fields": "String moveSequence;",
    "cases": [
      {
        "label": "构造器生成指定数量合法移动和分隔符（概率分布另行复核）",
        "setup": "RobotMover x=new RobotMover(6);String[] a=x.moveSequence.split(\"_\");boolean ok=x.moveSequence.endsWith(\"_\")&&a.length==6;for(String s:a)ok&=List.of(\"up\",\"down\",\"left\",\"right\").contains(s);",
        "condition": "ok"
      },
      {
        "label": "统计重叠子串",
        "setup": "RobotMover x=new RobotMover(1);x.moveSequence=\"right_down_left_down_right_down_up_up_up_\";",
        "condition": "x.countOccurrences(\"up_up\")==2&&x.countOccurrences(\"right_d\")==2&&x.countOccurrences(\"down\")==3"
      },
      {
        "label": "无匹配与保持原值",
        "setup": "RobotMover x=new RobotMover(1);x.moveSequence=\"up_up_\";",
        "condition": "x.countOccurrences(\"left\")==0&&x.countOccurrences(\"up\")==2&&x.moveSequence.equals(\"up_up_\")"
      }
    ],
    "kind": "methods",
    "support": ""
  },
  "AP-FRQ69fc5af861bea528S6": {
    "class_name": "Feeder",
    "fields": "int currentFood;",
    "cases": [
      {
        "label": "一天消耗符合合法范围且不出现负数（概率分布另行复核）",
        "setup": "Feeder x=new Feeder();x.currentFood=1000;x.simulateOneDay(3);int used=1000-x.currentFood;",
        "condition": "x.currentFood==0||(used>=30&&used<=150&&used%3==0)"
      },
      {
        "label": "食物不足时清空；初始无食物返回零天",
        "setup": "Feeder x=new Feeder();x.currentFood=1;x.simulateOneDay(2);",
        "condition": "x.currentFood==0&&x.simulateManyDays(2,5)==0"
      },
      {
        "label": "独立检查多天模拟的调用与提前结束",
        "setup": "Feeder x=new Feeder(){public void simulateOneDay(int n){currentFood=Math.max(0,currentFood-100);}};x.currentFood=250;int a=x.simulateManyDays(10,5);x.currentFood=1000;int b=x.simulateManyDays(10,2);",
        "condition": "a==3&&b==2&&x.currentFood==800"
      }
    ],
    "kind": "methods",
    "support": ""
  },
  "AP-FRQ69fc5af861bea528S8": {
    "class_name": "StringAnalyzer",
    "fields": "",
    "cases": [
      {
        "label": "重叠匹配只计第一次",
        "setup": "StringAnalyzer x=new StringAnalyzer();",
        "condition": "x.countRepeat(\"AAAAA\",\"AA\")==2&&x.countRepeat(\"AABABABAA\",\"ABA\")==2"
      },
      {
        "label": "无匹配和普通匹配",
        "setup": "StringAnalyzer x=new StringAnalyzer();",
        "condition": "x.countRepeat(\"ABBAABB\",\"ABA\")==0&&x.countRepeat(\"BAAB\",\"AA\")==1"
      },
      {
        "label": "末尾匹配，连续匹配",
        "setup": "StringAnalyzer x=new StringAnalyzer();",
        "condition": "x.countRepeat(\"xxAB\",\"AB\")==1&&x.countRepeat(\"ABABAB\",\"AB\")==3"
      }
    ],
    "kind": "methods",
    "support": "",
    "note": "这里只检查 (a) 的 countRepeat 方法；(b) 是文字设计说明，请对照原评分指南复核。"
  },
  "AP-FRQ69fc5af861bea528S10": {
    "class_name": "AppointmentBook",
    "fields": "boolean[][] free=new boolean[9][60];private boolean isMinuteFree(int p,int m){return free[p][m];}private void reserveBlock(int p,int s,int d){for(int i=s;i<s+d;i++)free[p][i]=false;}",
    "cases": [
      {
        "label": "找最早连续时间段，不修改预约表",
        "setup": "AppointmentBook x=new AppointmentBook();Arrays.fill(x.free[2],10,15,true);Arrays.fill(x.free[2],30,45,true);Arrays.fill(x.free[2],50,60,true);",
        "condition": "x.findFreeBlock(2,15)==30&&x.findFreeBlock(2,9)==30&&x.findFreeBlock(2,20)==-1&&x.free[2][30]"
      },
      {
        "label": "完整 60 分钟与最后一分钟边界",
        "setup": "AppointmentBook x=new AppointmentBook();Arrays.fill(x.free[1],true);x.free[8][59]=true;",
        "condition": "x.findFreeBlock(1,60)==0&&x.findFreeBlock(8,1)==59"
      },
      {
        "label": "按课节优先预约且只占用指定分钟",
        "setup": "AppointmentBook x=new AppointmentBook();Arrays.fill(x.free[2],25,30,true);Arrays.fill(x.free[3],0,15,true);Arrays.fill(x.free[4],5,30,true);boolean a=x.makeAppointment(2,4,22);boolean b=x.makeAppointment(3,4,3);",
        "condition": "a&&b&&!x.free[4][5]&&!x.free[4][26]&&x.free[4][27]&&!x.free[3][0]&&x.free[3][3]&&!x.makeAppointment(2,4,30)"
      }
    ],
    "kind": "methods",
    "support": ""
  },
  "AP-FRQ69fc5af861bea528S3": {
    "kind": "parts",
    "parts": [
      {
        "kind": "snippet",
        "label": "A · 下载次数末位数字",
        "args": "int downloads",
        "examples": [
          {
            "input": 1734567,
            "expected": "exactly once",
            "label": "恰好再出现一次"
          },
          {
            "input": 325322,
            "expected": "not exactly once",
            "label": "出现超过一次"
          },
          {
            "input": 7,
            "expected": "not exactly once",
            "label": "一位数"
          },
          {
            "input": 1010,
            "expected": "exactly once",
            "label": "末位为零"
          },
          {
            "input": 111,
            "expected": "not exactly once",
            "label": "重复多个"
          }
        ],
        "reference": "int digit=downloads%10;int rest=downloads/10,count=0;while(rest>0){if(rest%10==digit)count++;rest/=10;}System.out.print(count==1?\"exactly once\":\"not exactly once\");"
      },
      {
        "kind": "snippet",
        "label": "B · 歌曲信息",
        "args": "String songInfo",
        "examples": [
          {
            "input": "Artist-Album-Song",
            "expected": "Song by Artist",
            "label": "基本格式"
          },
          {
            "input": "A B-C D-E F",
            "expected": "E F by A B",
            "label": "保留空格"
          }
        ],
        "reference": "int first=songInfo.indexOf(\"-\");int second=songInfo.indexOf(\"-\",first+1);System.out.print(songInfo.substring(second+1)+\" by \"+songInfo.substring(0,first));"
      }
    ]
  },
  "AP-FRQ69fc5af861bea528S4": {
    "kind": "parts",
    "parts": [
      {
        "kind": "snippet",
        "label": "A · 居中文本",
        "args": "int colWidth,String text",
        "examples": [
          {
            "input": [
              5,
              "ab"
            ],
            "expected": "|.ab..|",
            "label": "奇数个补点"
          },
          {
            "input": [
              5,
              "abc"
            ],
            "expected": "|.abc.|",
            "label": "偶数个补点"
          },
          {
            "input": [
              3,
              "abcd"
            ],
            "expected": "abcd",
            "label": "超过宽度"
          },
          {
            "input": [
              3,
              "abc"
            ],
            "expected": "|abc|",
            "label": "刚好等宽"
          },
          {
            "input": [
              1,
              ""
            ],
            "expected": "|.|",
            "label": "空文本"
          }
        ],
        "reference": "if(text.length()>colWidth)System.out.print(text);else{int left=(colWidth-text.length())/2;System.out.print(\"|\");for(int i=0;i<left;i++)System.out.print(\".\");System.out.print(text);for(int i=0;i<colWidth-text.length()-left;i++)System.out.print(\".\");System.out.print(\"|\");}"
      },
      {
        "kind": "snippet",
        "label": "B · 最长前缀",
        "args": "String text,String otherText",
        "examples": [
          {
            "input": [
              "apple",
              "pear"
            ],
            "expected": "1",
            "label": "短前缀"
          },
          {
            "input": [
              "apple",
              "pineapple"
            ],
            "expected": "5",
            "label": "完整匹配"
          },
          {
            "input": [
              "apple",
              "happy"
            ],
            "expected": "3",
            "label": "中间长度"
          },
          {
            "input": [
              "apple",
              "leek"
            ],
            "expected": "0",
            "label": "没有匹配"
          },
          {
            "input": [
              "",
              "a"
            ],
            "expected": "0",
            "label": "空文本"
          }
        ],
        "reference": "int best=0;for(int i=1;i<=text.length();i++)if(otherText.contains(text.substring(0,i)))best=i;System.out.print(best);"
      }
    ]
  },
