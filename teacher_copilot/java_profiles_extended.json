        "condition": "x.rollCubes().equals(\"AA\")&&x.rollCubes().equals(\"BB\")"
      },
      {
        "label": "不同对象之间独立",
        "setup": "CubePair x=new CubePair(\"color\",\"letter\");CubePair y=new CubePair(\"number\");",
        "condition": "x.rollCubes().equals(\"redA\")&&y.rollCubes().equals(\"11\")"
      }
    ],
