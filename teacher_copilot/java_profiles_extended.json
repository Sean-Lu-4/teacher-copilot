  "AP-FRQd841c16efb454b49S1": {
    "class_name": "Shop",
    "fields": "Shelf[] shelfArray;",
    "cases": [
      {
        "label": "跨货架合并零件，车轴不足",
        "setup": "Shop x=new Shop();x.shelfArray=new Shelf[]{new Shelf(4,0),new Shelf(0,10)};",
        "condition": "x.getPossibleAssemblies()==4&&x.shelfArray.length==2&&x.shelfArray[0].getNumAxles()==4"
      },
      {
        "label": "奇数车轮向下取整",
        "setup": "Shop x=new Shop();x.shelfArray=new Shelf[]{new Shelf(20,3),new Shelf(0,2)};",
        "condition": "x.getPossibleAssemblies()==2"
      },
      {
        "label": "空数组与无车轮",
        "setup": "Shop x=new Shop();x.shelfArray=new Shelf[]{};int a=x.getPossibleAssemblies();x.shelfArray=new Shelf[]{new Shelf(3,0)};",
        "condition": "a==0&&x.getPossibleAssemblies()==0"
      }
    ],
    "kind": "methods",
    "support": "record Shelf(int axles,int wheels){public int getNumAxles(){return axles;}public int getNumWheels(){return wheels;}}"
  },
  "AP-FRQd841c16efb454b49S2": {
    "class_name": "Painter",
    "fields": "Surface[] surfaceArray;",
    "cases": [
      {
        "label": "总面积刚好等于覆盖面积",
        "setup": "Painter x=new Painter();x.surfaceArray=new Surface[]{new Surface(20,10),new Surface(10,20)};",
        "condition": "x.hasEnoughPaint(1)&&x.surfaceArray.length==2"
      },
      {
        "label": "小数面积不可截断",
        "setup": "Painter x=new Painter();x.surfaceArray=new Surface[]{new Surface(20.01,20)};",
        "condition": "!x.hasEnoughPaint(1)&&x.hasEnoughPaint(2)"
      },
      {
        "label": "累加所有表面",
        "setup": "Painter x=new Painter();x.surfaceArray=new Surface[]{new Surface(10,30),new Surface(10,30),new Surface(10,30)};",
        "condition": "!x.hasEnoughPaint(2)&&x.hasEnoughPaint(3)"
      }
    ],
    "kind": "methods",
    "support": "record Surface(double width,double length){public double getWidth(){return width;}public double getLength(){return length;}}"
  },
  "AP-FRQe12b4823e927b30fS1": {
    "class_name": "GamePlatform",
    "fields": "ArrayList<GameAccount> allPlayers;",
    "cases": [
      {
        "label": "包含 13 和 19 岁，排除其他年龄",
        "setup": "GamePlatform x=new GamePlatform();x.allPlayers=new ArrayList<>(List.of(new GameAccount(\"a\",12),new GameAccount(\"b\",13),new GameAccount(\"c\",19),new GameAccount(\"d\",20)));",
        "condition": "x.avgTeenAccounts()==16&&x.allPlayers.size()==4"
      },
      {
        "label": "保留小数，分母仅包含青少年",
        "setup": "GamePlatform x=new GamePlatform();x.allPlayers=new ArrayList<>(List.of(new GameAccount(\"a\",15),new GameAccount(\"b\",16),new GameAccount(\"c\",60)));",
        "condition": "x.avgTeenAccounts()==15.5"
      },
      {
        "label": "唯一青少年",
        "setup": "GamePlatform x=new GamePlatform();x.allPlayers=new ArrayList<>(List.of(new GameAccount(\"a\",17)));",
        "condition": "x.avgTeenAccounts()==17"
      }
    ],
    "kind": "methods",
    "support": "record GameAccount(String username,int age){public String getUsername(){return username;}public int getAge(){return age;}}"
  },
  "AP-FRQe12b4823e927b30fS2": {
    "class_name": "Season",
    "fields": "ArrayList<Game> allGames;",
    "cases": [
      {
        "label": "平局中断连胜；最长连胜在末尾",
        "setup": "Season x=new Season();x.allGames=new ArrayList<>(List.of(new Game(2,1),new Game(1,1),new Game(3,1),new Game(4,2)));",
        "condition": "x.getLongestHomeWinStreak()==2&&x.allGames.size()==4"
      },
      {
        "label": "没有获胜场次",
        "setup": "Season x=new Season();x.allGames=new ArrayList<>(List.of(new Game(1,2),new Game(1,1)));",
        "condition": "x.getLongestHomeWinStreak()==0"
      },
      {
        "label": "保留较早出现的最大值",
        "setup": "Season x=new Season();x.allGames=new ArrayList<>(List.of(new Game(2,1),new Game(3,1),new Game(4,1),new Game(0,1),new Game(2,1)));",
        "condition": "x.getLongestHomeWinStreak()==3"
      }
    ],
    "kind": "methods",
    "support": "record Game(int home,int away){public int getHomeScore(){return home;}public int getAwayScore(){return away;}}"
  },
  "AP-FRQ8b32f5bc1d3ab57aS1": {
    "class_name": "FlightSeatingChart",
    "fields": "Passenger[][] chart;",
    "cases": [
      {
        "label": "只选择目标行之后的乘客，清空原位置",
        "setup": "FlightSeatingChart x=new FlightSeatingChart();Passenger a=new Passenger(100,\"a\"),b=new Passenger(5,\"b\"),c=new Passenger(9,\"c\");x.chart=new Passenger[][]{{a,null},{b,null},{null,c}};x.upgrade(0,1);",
        "condition": "x.chart[0][1]==c&&x.chart[2][1]==null&&x.chart[0][0]==a&&x.chart[1][0]==b"
      },
      {
        "label": "跳过空位，接受并列最高的任意乘客",
        "setup": "FlightSeatingChart x=new FlightSeatingChart();Passenger a=new Passenger(8,\"a\"),b=new Passenger(8,\"b\");x.chart=new Passenger[][]{{null,null},{a,b}};x.upgrade(0,0);",
        "condition": "(x.chart[0][0]==a&&x.chart[1][0]==null&&x.chart[1][1]==b)||(x.chart[0][0]==b&&x.chart[1][1]==null&&x.chart[1][0]==a)"
      },
      {
        "label": "非方阵、最后一行乘客",
        "setup": "FlightSeatingChart x=new FlightSeatingChart();Passenger a=new Passenger(1,\"a\");x.chart=new Passenger[][]{{null,null,null},{null,null,a}};x.upgrade(0,2);",
        "condition": "x.chart[0][2]==a&&x.chart[1][2]==null"
      }
    ],
    "kind": "methods",
    "support": "record Passenger(int rating,String id){public int getRating(){return rating;}public String getID(){return id;}}"
  },
  "AP-FRQ8b32f5bc1d3ab57aS2": {
    "class_name": "GameGrid",
    "fields": "String[][] grid;",
    "cases": [
      {
        "label": "四个方向离开单格网格",
        "setup": "GameGrid x=new GameGrid();boolean ok=true;for(String s:List.of(\"NE\",\"NW\",\"SE\",\"SW\")){x.grid=new String[][]{{new String(s)}};ok&=x.navigate(0,0)==1;}",
        "condition": "ok"
      },
      {
        "label": "非方阵、多步路径、保持网格不变",
        "setup": "GameGrid x=new GameGrid();x.grid=new String[][]{{\"SE\",\"NE\",\"NE\"},{\"NE\",\"NE\",\"NE\"}};",
        "condition": "x.navigate(0,0)==3&&x.grid[0][0].equals(\"SE\")"
      },
      {
        "label": "向左下方越界",
        "setup": "GameGrid x=new GameGrid();x.grid=new String[][]{{\"SW\",\"SW\"},{\"SW\",\"SW\"},{\"SW\",\"SW\"}};",
        "condition": "x.navigate(0,1)==2"
      }
    ],
    "kind": "methods",
    "support": ""
  },
