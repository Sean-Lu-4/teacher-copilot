  "AP-FRQ414a8797b527e415S1": {
    "class_name": "Car",
    "fields": "",
    "cases": [
      {
        "label": "连续旅行正确扣减燃油",
        "setup": "Car x=new Car(10,30);",
        "condition": "x.canMakeTrip(120)&&x.canMakeTrip(90)&&!x.canMakeTrip(225)&&x.canMakeTrip(90)&&!x.canMakeTrip(1)"
      },
      {
        "label": "油量刚好足够；失败不扣油",
        "setup": "Car x=new Car(12,15);",
        "condition": "!x.canMakeTrip(300)&&x.canMakeTrip(180)&&!x.canMakeTrip(1)"
      },
      {
        "label": "两个对象的燃油独立",
        "setup": "Car x=new Car(1.5,20);Car y=new Car(2,10);",
        "condition": "x.canMakeTrip(20)&&y.canMakeTrip(20)&&x.canMakeTrip(10)"
      }
    ],
