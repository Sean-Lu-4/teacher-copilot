    "class_name": "CubePair",
    "fields": "",
    "cases": [
      {
        "label": "双参数保留两个方块的种类与顺序",
        "setup": "CubePair x=new CubePair(\"number\",\"color\");",
        "condition": "x.rollCubes().equals(\"1red\")&&x.rollCubes().equals(\"2orange\")"
