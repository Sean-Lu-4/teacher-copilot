  "AP-FRQ414a8797b527e415S2": {
    "class_name": "TrashCan",
    "fields": "",
    "cases": [
      {
        "label": "未满时累计，超过容量后保留余量",
        "setup": "TrashCan x=new TrashCan(10);",
        "condition": "Math.abs(x.acceptTrash(2.5)-7.5)<1e-8&&Math.abs(x.acceptTrash(3.5)-4)<1e-8&&Math.abs(x.acceptTrash(6)-8)<1e-8"
      },
      {
        "label": "恰好装满时清空",
        "setup": "TrashCan x=new TrashCan(10);",
        "condition": "x.acceptTrash(4)==6&&x.acceptTrash(6)==10&&x.acceptTrash(1)==9"
      },
      {
        "label": "原题小数示例与对象独立",
        "setup": "TrashCan x=new TrashCan(3);TrashCan y=new TrashCan(8);",
        "condition": "Math.abs(x.acceptTrash(1)-2)<1e-8&&Math.abs(x.acceptTrash(3.2)-1.8)<1e-8&&y.acceptTrash(1)==7"
      }
    ],
